# ==============================================================================
# CrisisAgent Environment Configuration
# ==============================================================================

# AI Backend Selection
# Vision: 'mock' (zero-config demo), 'gemini', or 'ollama'
LLM_VISION_BACKEND=mock

# Reasoning: 'mock' (zero-config demo), 'groq', or 'ollama'
LLM_REASONING_BACKEND=mock

# Cloud API Keys (Optional - only needed if not using 'mock' or 'ollama')
GEMINI_API_KEY=
GROQ_API_KEY=

# Local Ollama Configuration (Optional - for 100% offline edge mode)
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=qwen3-vl
OLLAMA_REASONING_MODEL=llama3.1

# Server & Database Settings
HOST=0.0.0.0
PORT=8000
DB_PATH=crisisagent.db
